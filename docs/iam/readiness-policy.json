{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions", "lambda:GetAccountSettings",
        "servicequotas:ListServiceQuotas", "servicequotas:GetServiceQuota",
        "ecr:DescribeRepositories", "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}
    },
    {
      "Sid": "ProjectStackMetadataOnly",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": [
        "arn:aws:cloudformation:ap-south-1:ACCOUNT_ID:stack/CDKToolkit/*",
        "arn:aws:cloudformation:ap-south-1:ACCOUNT_ID:stack/EcoRoute*/*"
      ]
    },
    {
      "Sid": "BootstrapVersionOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "OwnIdentityPolicyAssessmentOnly",
      "Effect": "Allow",
      "Action": ["iam:ListAttachedUserPolicies", "iam:SimulatePrincipalPolicy"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:user/devesh_eco"
    }
  ]
}
