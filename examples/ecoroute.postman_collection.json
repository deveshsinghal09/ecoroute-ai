  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.variables.set('departure_at', new Date(now.getTime()+600000).toISOString());",
          "pm.variables.set('observed_at', now.toISOString());",
          "pm.variables.set('history_start', new Date(now.getTime()-3600000).toISOString());",
          "pm.variables.set('event_id', pm.variables.replaceIn('{{$guid}}').replace(/-/g,''));",
          "pm.variables.set('alert_end_at', new Date(now.getTime()+86400000).toISOString().slice(0,13)+':00:00Z');"
        ]
      }
    }
  ],
